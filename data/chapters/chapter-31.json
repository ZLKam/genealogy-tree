{
  "title": "以环公",
  "originalPage": 34,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "kind": "branch", "marker": "☆", "text": "启余娶莫氏生三子：以环、以宝、以容。" },
      { "level": 1, "marker": "一、", "text": "以环娶郭氏生二子：庆初、业初，三女：月连、月葵、肖兰。" },
      { "level": 2, "marker": "1、", "text": "庆初娶唐氏生一子：庆泳，四女：甘凤、甘丽、甘梅、甘燕。" },
      { "level": 3, "marker": "①、", "text": "庆泳娶莫氏生二子：镇昌、泽昌，一女：冰仪。" },
      { "level": 3, "marker": "②、", "text": "甘凤嫁西渡陈门、甘丽嫁广东廉江钟门、甘梅嫁归义吴门、甘燕嫁贵港大圩陈门。" },
      { "level": 2, "marker": "2、", "text": "业初娶钟氏生二子：庆锋、庆观，女：秋萍。" },
      { "level": 3, "marker": "①、", "text": "庆锋娶黄氏生一子：健昌，一女：玉婷。" },
      { "level": 3, "marker": "②、", "text": "庆观娶黄氏。" },
      { "level": 2, "marker": "3、", "text": "月连嫁广东高明杜门、月葵嫁云浮刘门、肖兰嫁义新关门。" }
    ]
  }
}
