{
  "title": "以礼公",
  "originalPage": 32,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "level": 1, "marker": "二、", "text": "以礼娶梁氏生四子：海初、宝初、维初、活初。" },
      { "level": 2, "marker": "1、", "text": "海初娶覃静华生一子：庆森，三女：孔媚、娟兰、娟华。" },
      { "level": 3, "marker": "①、", "text": "庆森娶陈锦芬生一子：盛光。" },
      { "level": 3, "marker": "②、", "text": "孔娟嫁苍梧岭脚黄门、娟兰嫁安平。" },
      { "level": 2, "marker": "2、", "text": "宝初娶　　　　生二子：惠文、二弟。" },
      { "level": 2, "marker": "3、", "text": "维初娶李敏玲生一子：柏林，一女：丽妮。" },
      { "level": 3, "marker": "①、", "text": "柏林中专毕业，娶徐敏丽。" },
      { "level": 3, "marker": "②、", "text": "丽妮中专毕业，嫁三堡。" },
      { "level": 2, "marker": "4、", "text": "活初娶赖秀容生一子：福焕，一女：北芬。" },
      { "level": 3, "text": "福焕娶陈秀娇。" }
    ]
  }
}
