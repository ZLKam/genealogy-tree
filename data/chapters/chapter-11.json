{
  "title": "肇明、肇福、肇文、肇珍公",
  "originalPage": 14,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "level": 1, "marker": "三、", "text": "肇明 无嗣。" },
      { "level": 1, "marker": "四、", "text": "肇福 无嗣。" },
      { "kind": "branch", "marker": "☆", "text": "作广：" },
      { "level": 1, "marker": "一：", "text": "肇文娶黎英生三子：寿永、寿松、寿通，一女妙燕嫁中林。" },
      { "level": 2, "marker": "1、", "text": "寿永娶罗连芳生一子：传毅，一女：丽燕嫁大和村。" },
      { "level": 3, "text": "传毅娶伍静宏生二子：深源、甘源。" },
      { "level": 2, "marker": "2、", "text": "寿松娶陈冬梅生一子：延东，三女：婷婷嫁信宜、婷华嫁新圹、婷容嫁江西萍乡。" },
      { "level": 2, "marker": "3、", "text": "寿通娶梁昌兑生二子：海成、延烽，二女：火娇、孔连。" },
      { "level": 1, "marker": "二、", "text": "肇珍娶李彩英生一子：寿钊，四女：妙莲嫁马路杨叶、妙芳嫁车垌、妙华嫁上村、妙容嫁中林。" },
      { "level": 2, "text": "寿钊娶龙少华生一子：延浪，四女：婷婷、华婷、少婷、龙婷。" },
      { "level": 3, "text": "延浪娶吴锦芬" }
    ]
  }
}
