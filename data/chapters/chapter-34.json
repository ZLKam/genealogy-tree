{
  "title": "以新、以荫公",
  "originalPage": 38,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "kind": "branch", "marker": "☆", "text": "启鉴娶黄氏生二子：以新、以荫。" },
      { "level": 1, "marker": "一、", "text": "以新娶黄氏生四子：进初、运初、达初、远初，二女。" },
      { "level": 2, "marker": "1、", "text": "进初娶李氏生一子：寿宏，三女。" },
      { "level": 3, "text": "寿宏在岑溪市土产公司工作，娶钟氏生一子：延印，一女：小梅。" },
      { "level": 2, "marker": "2、", "text": "运初娶莫氏生三子：寿振、寿坤、庆强，二女。" },
      { "level": 3, "marker": "①、", "text": "寿振娶李氏生二子：永昌、远昌。" },
      { "level": 3, "marker": "②、", "text": "寿坤娶莫氏。" },
      { "level": 2, "marker": "3、", "text": "达初娶梁氏生三子：庆金、庆杰、庆权，三女。" },
      { "level": 3, "marker": "①、", "text": "庆金娶廖氏生二子：源昌、亚弟。" },
      { "level": 3, "marker": "②、", "text": "庆杰娶欧氏生一子：甘弟。" },
      { "level": 3, "marker": "③、", "text": "庆权娶李氏生二子：大弟、二弟。" },
      { "level": 2, "marker": "4、", "text": "远初娶黄氏生三子：庆年、庆江、庆波，三女。" },
      { "level": 3, "marker": "①、", "text": "庆年娶李氏生一子：关昌。" },
      { "level": 3, "marker": "②、", "text": "庆江娶莫氏" },
      { "level": 3, "marker": "③、", "text": "庆波娶廖氏" },
      { "level": 1, "marker": "二、", "text": "以荫" },
      { "level": 1, "text": "以德娶李素英生四子：瑞初、培初、发初、行初，二女：凤娇、容初。均住南洋。" },
      { "level": 2, "marker": "1、", "text": "瑞初娶杨水莲生三子：天伦、天华、天威。三女：丽燕、丽花、丽娟。" },
      { "level": 3, "text": "天伦娶刘蔼娜生一子：子乐，一女：沚蒽。" },
      { "level": 2, "marker": "2、", "text": "培初娶陈丽燕生二子：天健、天俊，一女：淑敏。" },
      { "level": 2, "marker": "3、", "text": "发初娶汤义红生三女：彩莹、彩妮、彩媚。" },
      { "level": 2, "marker": "4、", "text": "行初娶钟玉梅。" }
    ]
  }
}
