{
  "title": "肇球、肇全、肇奇公",
  "originalPage": 13,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "level": 1, "marker": "二、", "text": "肇球娶罗氏生二女：大女嫁水口、二女嫁三堡。" },
      { "kind": "branch", "marker": "☆", "text": "作华：" },
      { "level": 1, "marker": "一、", "text": "肇全，无嗣。" },
      { "level": 1, "marker": "二、", "text": "肇奇娶陈月华生三子：寿德、甘武、寿远，四女：菊莲嫁杨冲、妙兰嫁车垌、妙葵嫁杨叶、妙清嫁容县灵山。" },
      { "level": 2, "marker": "1、", "text": "寿德娶聂志莲生二子：延乐、延金，一女：小凤。" },
      { "level": 3, "marker": "①、", "text": "延乐娶梁妙坚生二子：泳洪、健洪，一女：小丽。" },
      { "level": 3, "marker": "②、", "text": "延金娶黄飞珍生二女：梓晴、美伊。" },
      { "level": 2, "marker": "2、", "text": "甘斌娶谢富梅生二子：甘炯、延超，一女：孔玲嫁中林。" },
      { "level": 2, "marker": "3、", "text": "寿远娶黄秋炎生二子：海亮、淼江，一女：慧妮。" }
    ]
  }
}
