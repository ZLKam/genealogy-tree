{
  "title": "肇伟、肇东、肇志、肇泽、肇记公",
  "originalPage": 17,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "kind": "branch", "marker": "☆", "text": "作乾：" },
      { "level": 1, "text": "肇伟娶罗桂华生一女：杏燕。" },
      { "kind": "branch", "marker": "☆", "text": "作坤：" },
      { "level": 1, "marker": "一、", "text": "肇东娶罗月清生二子：甘若、甘纳，三女：榕梅嫁中林、榕珍嫁东莞、榕清嫁广东。" },
      { "level": 2, "marker": "1、", "text": "甘若娶韦日米生一子：延康。" },
      { "level": 2, "marker": "2、", "text": "甘纳娶黎思虹生二子：子黎、子明。" },
      { "level": 1, "marker": "二、", "text": "肇志娶李锦英生二子：甘朗、甘锐。" },
      { "level": 2, "marker": "1、", "text": "甘朗广西师大毕业，娶袁春艳生二子：洁霖、伟杰。" },
      { "level": 2, "marker": "2、", "text": "甘锐河北燕山大学毕业娶叶丽欣生一子：泽霖。叶丽欣本科毕业。" },
      { "level": 1, "marker": "三、", "text": "肇泽娶卢莲山生一子：甘生，一女：甘雨，大学毕业。" },
      { "level": 1, "marker": "四、", "text": "肇记娶莫梅生二子：甘宁、甘壮，广西师大毕业，在筋竹中学当教师。" }
    ]
  }
}
