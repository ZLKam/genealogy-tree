{
  "title": "以葵公",
  "originalPage": 30,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "level": 1, "marker": "三、", "text": "以葵娶林桂文生六子：仕初、杰初、侃初、仍初、侨初、傲初，二女：超容、超明。均移居南洋。" },
      { "level": 2, "marker": "1、", "text": "仕初娶易秋霞生二子：添业、添义，二女：慧娟、慧妮。" },
      { "level": 3, "marker": "①、", "text": "添业娶陈丽霞生二子：旻昌、泳昌，二女：晓琪、晓韵。" },
      { "level": 3, "marker": "②、", "text": "添义" },
      { "level": 2, "marker": "2、", "text": "杰初娶颜燕梅生二子：天成、天龙，一女：翠云。" },
      { "level": 3, "marker": "①、", "text": "天成娶岑惠娟生三女：依雯、傲仪、淼欣。" },
      { "level": 3, "marker": "②、", "text": "天龙娶叶雪燕生二子：栐历、栐维，一女：栐乐。" },
      { "level": 2, "marker": "3、", "text": "侃初娶苏金珠生二子：天仁、天佑，一女：慧丽。" },
      { "level": 3, "marker": "①、", "text": "天仁" },
      { "level": 3, "marker": "②、", "text": "天佑娶丘殷庄生一子：睿昌，一女：悦芊。" },
      { "level": 2, "marker": "4、", "text": "仍初" },
      { "level": 2, "marker": "5、", "text": "侨初娶张凤美生二子：天豪、天维，一女：慧君。" },
      { "level": 2, "marker": "6、", "text": "傲初娶龚秀兰生三子：添源、添俊、添培，一女：慧欣。" }
    ]
  }
}
