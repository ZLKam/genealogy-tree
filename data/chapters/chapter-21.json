{
  "title": "肇松公",
  "originalPage": 24,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "kind": "branch", "marker": "☆", "text": "三房　福文娶黎氏生二子：肇松、肇椿，" },
      { "level": 1, "marker": "一、", "text": "肇松娶黄氏生四子：寿新、寿荣、寿杰、寿堂。" },
      { "level": 2, "marker": "1、", "text": "寿新去马来西亚新山，娶陈氏生一子：延鹏→生二子：鸿昆、　　。" },
      { "level": 2, "marker": "2、", "text": "寿荣娶苏氏生二子：延鸿、延明，二女。" },
      { "level": 3, "marker": "①、", "text": "延鸿娶余氏生二子：禧源、海源。" },
      { "level": 4, "text": "禧源娶李氏生二子：亚壬、亚孔。" },
      { "level": 3, "marker": "②、", "text": "延明娶梁氏生二子：龙源、兑源。" },
      { "level": 4, "text": "龙源生一子：宏坚。" },
      { "level": 2, "marker": "3、", "text": "寿杰娶成氏生二子：延岳、延华，一女。" },
      { "level": 3, "marker": "①、", "text": "延岳在昙容中学工作，娶唐碧坤生二子：德源、坤源，四女。" },
      { "level": 4, "text": "德源娶严氏生一子：宗明。" },
      { "level": 4, "text": "宗明娶苏氏生二子：梓乐、梓羽。" },
      { "level": 4, "text": "坤源娶莫氏生四子：宗旭、宗武、宗佳、宗泽。" },
      { "level": 3, "marker": "②、", "text": "延华娶黄氏育一子：朋源，一女。" },
      { "level": 2, "marker": "4、", "text": "寿堂娶廖氏生二子：延经、延壬。" },
      { "level": 3, "marker": "①、", "text": "延经 无嗣。" },
      { "level": 3, "marker": "②、", "text": "延壬娶覃氏生二子：印源、孔源。" },
      { "level": 4, "text": "印源大学本科毕业，娶莫氏在深圳工作。" }
    ]
  }
}
