{
  "title": "以兰、以惠公",
  "originalPage": 29,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "kind": "branch", "marker": "☆", "text": "启锦娶陈氏1生一子：以兰。启锦娶陈氏2生三子：以惠、以葵、以庄。" },
      { "level": 1, "marker": "一、", "text": "以兰娶龚氏生二子：汉初、耀初。" },
      { "level": 2, "marker": "1、", "text": "汉初娶岑氏生三子：庆华、庆德、庆永。" },
      { "level": 3, "marker": "①、", "text": "庆华娶唐氏生一子：邓石，三女。" },
      { "level": 3, "marker": "②、", "text": "庆德娶李氏生一子：壬生，三女。" },
      { "level": 3, "marker": "③、", "text": "庆永娶罗氏生二子：大弟、二弟。" },
      { "level": 2, "marker": "2、", "text": "耀初娶钟汉华生五子：庆富、庆崇、庆桂、庆柱、庆运。" },
      { "level": 3, "marker": "①、", "text": "庆富娶蒲意珍生二子：剑昌、进昌，一女：妙凤。" },
      { "level": 3, "marker": "②、", "text": "庆崇娶郭妙兰生一子：泽昌，一女：思凤。" },
      { "level": 4, "text": "泽昌娶黄丽玲生二子：荣锋、荣炜，一女：紫悦。" },
      { "level": 3, "marker": "③、", "text": "庆桂娶盘静生一子：甘栩，三女：孔平、菲燕、菲平。" },
      { "level": 3, "marker": "④、", "text": "庆柱娶陈燕生五女：关梅、月兰、敏华、永华、小华。" },
      { "level": 3, "marker": "⑤、", "text": "庆运娶周宏萍生一子：国昌，二女：国凤、春玲。" },
      { "level": 1, "marker": "二、", "text": "以惠娶刘惠芬生三子：建初、延初、定初，一女：秀文。" },
      { "level": 2, "marker": "1、", "text": "建初娶李意芬生四子：庆东、庆南、庆北、庆光，二女：关娇、清兰。" },
      { "level": 3, "marker": "①、", "text": "庆东娶李锦芬生二子：培昌、兑昌，一女：妙玲。" },
      { "level": 3, "marker": "②、", "text": "庆南娶廖培华生二子：洪昌、朋昌。" },
      { "level": 3, "marker": "③、", "text": "庆北娶罗月芬生一子：南昌，二女：燕林、海玲。" },
      { "level": 3, "marker": "④、", "text": "庆光娶覃淑丽生二子：智昌、俊昌，女：翠兰。" },
      { "level": 2, "marker": "2、", "text": "延初娶黄氏生二子：庆健、庆锋。" },
      { "level": 3, "marker": "①、", "text": "庆健娶龙珏君生一子：峻荣，三女：娟瑛、娟萍、娟鸿。" },
      { "level": 3, "marker": "②、", "text": "庆锋娶卢凤群生一子：龙胤，一女：小愿。" },
      { "level": 2, "marker": "3、", "text": "定初娶黄氏生二子：庆忠、庆宁。" },
      { "level": 3, "marker": "①、", "text": "庆忠 育女：嘉敏。" },
      { "level": 3, "marker": "②、", "text": "庆宁娶雷纯洁生一子：昊聪，一女月娇。" }
    ]
  }
}
