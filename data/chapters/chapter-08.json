{
  "title": "肇清、肇朋公",
  "originalPage": 11,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "kind": "branch", "marker": "☆", "text": "作盛：" },
      { "level": 1, "marker": "一、", "text": "肇清娶黄氏生三子：寿龙、寿志、寿湖。" },
      { "level": 1, "text": "三女：杏芬，嫁车垌，杏芳嫁昙琼，丽芳嫁南渡。" },
      { "level": 2, "marker": "1、", "text": "寿龙娶陈珍生三子：延斌、延贞、延鹏。" },
      { "level": 3, "marker": "①、", "text": "延斌娶欧海清生一子：锦源，二女：思凤、琳桦。" },
      { "level": 3, "marker": "②、", "text": "延贞" },
      { "level": 3, "marker": "③、", "text": "延鹏娶秦小芳生一子：棋源，一女：琳惠。" },
      { "level": 2, "marker": "2、", "text": "寿志娶程氏生二子：甘灿、甘洪。" },
      { "level": 3, "marker": "①、", "text": "甘灿娶庞月萍生二子：杰锋、振源。" },
      { "level": 3, "marker": "②、", "text": "甘洪" },
      { "level": 2, "marker": "3、", "text": "寿湖，在岑溪财政局工作，娶曾小容生一子：振宁，一女：思凡。" },
      { "level": 1, "marker": "二、", "text": "肇鹏娶钟氏、杨氏生三子：寿平、寿标、寿桐，三女：杏珍嫁荔王，杏梅嫁广东，杏葵嫁东莞。" },
      { "level": 2, "marker": "1、", "text": "寿平娶刘银美生二子：延宁、延业。" },
      { "level": 3, "marker": "①、", "text": "延宁娶陈玲生一子：浩然，一女：思思。" },
      { "level": 3, "marker": "②、", "text": "延业" },
      { "level": 2, "marker": "2、", "text": "寿标娶黎平生二子：甘航、甘志。" },
      { "level": 3, "marker": "①、", "text": "甘航，广西医科大学毕业，" },
      { "level": 3, "marker": "②、", "text": "甘志娶王平花生三子：甘伟、甘健、天成。" },
      { "level": 2, "marker": "3、", "text": "寿桐娶韦娟丽生一子：亦轩。" }
    ]
  }
}
