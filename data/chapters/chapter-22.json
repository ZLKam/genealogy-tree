{
  "title": "肇椿、肇桢、肇枢、肇良、肇彬公",
  "originalPage": 25,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "level": 1, "marker": "二、", "text": "肇椿娶罗氏生二子：寿进、寿鉴。" },
      { "level": 2, "marker": "1、", "text": "寿进娶吴氏生三子：延瑞、延兆、延昭。" },
      { "level": 3, "marker": "①、", "text": "延瑞 无嗣。" },
      { "level": 3, "marker": "②、", "text": "延兆娶廖品光生三子：波源、培源、思源。" },
      { "level": 3, "marker": "③、", "text": "延昭娶吴万玲生一女：四妹。" },
      { "kind": "branch", "marker": "☆", "text": "四房　福亮娶黎氏生二子：肇桢、肇枢；福官娶苏氏生一子：肇良；福玩娶黎氏生一子：肇彬。" },
      { "level": 1, "marker": "一、", "text": "肇桢娶陈氏生三女，均嫁容县。" },
      { "level": 1, "marker": "二、", "text": "肇枢娶梁氏生一子：寿祥，一女：寿英。" },
      { "level": 2, "text": "寿祥娶梁碧文生二子：延武、延周，四个女，分别嫁昙容、南渡和广东。" },
      { "level": 3, "marker": "①、", "text": "延武 无嗣。" },
      { "level": 3, "marker": "②、", "text": "延周娶黄彩琼生一子：振生。" },
      { "level": 1, "marker": "三、", "text": "肇良娶陈氏生一子：寿南，四女，分别嫁上双、洴垌、昙容、岭腰。" },
      { "level": 2, "text": "寿南娶卢氏 无嗣，继延胜。" },
      { "level": 3, "text": "延胜娶杨腰生三女：月芬、月兰、炎华。" },
      { "level": 1, "marker": "四、", "text": "肇彬娶陈氏生一子：寿乾，一女：三姑嫁大垌六家村。" },
      { "level": 2, "text": "寿乾娶唐瑞华生五子：延东、延海、延胜、××、延泽。" },
      { "level": 3, "marker": "①、", "text": "延东娶莫娟华生二子：栋元、昌元。昌元大学本科毕业，在贵港市当老师。" },
      { "level": 3, "marker": "②、", "text": "延海娶吴家连生二子：甘志、甘成。" },
      { "level": 3, "marker": "③、", "text": "延胜，过继寿南。" },
      { "level": 3, "marker": "④、", "text": "×× 早逝" },
      { "level": 3, "marker": "⑤、", "text": "延泽娶李丽燕生二子：甘杉、震元。" }
    ]
  }
}
