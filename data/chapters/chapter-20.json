{
  "title": "肇桐、肇楠、肇槐公",
  "originalPage": 23,
  "content": [],
  "lineageRecord": {
    "entries": [
      { "level": 1, "marker": "五、", "text": "肇桐 早逝。" },
      { "level": 1, "marker": "六、", "text": "肇楠 无嗣，生二女：十二姑嫁干冲口莫展南，生五子；十八姑嫁都功余辉。" },
      { "level": 1, "marker": "七、", "text": "肇槐娶卢氏生二子：寿和、寿旭，一女。" },
      { "level": 2, "marker": "1、", "text": "寿和娶岑氏生三子：延标、延深、延波。" },
      { "level": 3, "marker": "①、", "text": "延标娶罗景月生三子：金元、庚元、河元，一女：娟娟。" },
      { "level": 3, "marker": "②、", "text": "延深" },
      { "level": 3, "marker": "③、", "text": "延波娶黄炎。" },
      { "level": 2, "marker": "2、", "text": "寿旭娶莫氏生二子：延湖、延江，一女嫁大桐村。" }
    ]
  }
}
